{
  "name": "claude-code-ghcp-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run Claude Code with GitHub Copilot models through the GitHub Copilot SDK.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "claude-ghcp": "bin/claude-ghcp",
    "claude-ghcp-status": "bin/claude-ghcp-status",
    "claude-ghcp-stop": "bin/claude-ghcp-stop",
    "claude-litellm": "bin/claude-litellm",
    "claude-current": "bin/claude-current",
    "ghcp-doctor": "bin/ghcp-doctor",
    "ghcp-models": "bin/ghcp-models"
  },
  "scripts": {
    "bridge": "node src/server.mjs",
    "current-provider": "node src/provider-detection.mjs",
    "doctor": "node src/doctor.mjs",
    "models": "node src/list-models.mjs",
    "litellm:setup": "bash scripts/setup-litellm.sh",
    "litellm:start": "bash scripts/start-litellm.sh",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify/run.mjs",
    "verify:plan": "node scripts/verify/scenarios.mjs",
    "verify:probe": "node scripts/verify/probe.mjs",
    "verify:report": "node scripts/verify/report.mjs",
    "verify:doc": "node scripts/verify/report.mjs --markdown > docs/VERIFICATION.md && node scripts/verify/report.mjs --markdown=ko > docs/VERIFICATION_KO.md"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.269",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80"
  }
}
