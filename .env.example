# GitHub Copilot model used when Claude Code's requested model cannot be mapped.
GHCP_MODEL=claude-sonnet-5

# The bridge binds to loopback by default.
HOST=127.0.0.1
PORT=4142

# Required when starting the bridge directly. The launcher generates one.
BRIDGE_API_KEY=replace-with-a-random-local-token

# Existing Copilot CLI OAuth state is read from this directory.
COPILOT_HOME=~/.copilot

# Avoid writing prompt and response bodies to logs.
LOG_LEVEL=info

# External LiteLLM gateway settings used by bin/claude-litellm.
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=replace-with-a-scoped-virtual-key
LITELLM_MODEL=claude-sonnet-5

# Optional Claude Code family mappings. They default to LITELLM_MODEL.
# LITELLM_OPUS_MODEL=claude-opus-4-7
# LITELLM_SONNET_MODEL=claude-sonnet-5
# LITELLM_HAIKU_MODEL=claude-haiku-4-5
