# Reference values only. The launchers read exported environment variables and
# do not load a local .env file automatically.

# Default GitHub Copilot model. Explicit unavailable model IDs fail closed.
GHCP_MODEL=claude-sonnet-5

# The bridge binds to loopback by default.
HOST=127.0.0.1
PORT=4142

# Required when starting the bridge directly. The launcher generates one.
BRIDGE_API_KEY=replace-with-a-random-local-token

# Maximum accepted request body size in bytes (default: 256 MiB).
MAX_BODY_BYTES=268435456

# Maximum replayed conversation history in bytes (default: 256 MiB).
MAX_REPLAY_BYTES=268435456

# Session hardening limits.
MAX_STATES=64
MAX_TOOL_RESULTS=32
CLEANUP_TIMEOUT_MS=5000
PENDING_TOOL_WAIT_MS=10000
# SDK session create/resume/effort RPC wait, separate from the inference timeout.
SESSION_OPERATION_TIMEOUT_MS=60000
# Meaningful root-model progress resets the idle timer; the hard cap never resets.
TURN_IDLE_TIMEOUT_MS=300000
TURN_MAX_DURATION_MS=1800000
STATE_IDLE_TTL_MS=1800000

# Optional persistent bridge cache directory used by --background/agent view.
# GHCP_DAEMON_DIR=~/.cache/claude-code-ghcp-sdk

# Existing Copilot CLI OAuth state is read from this directory.
COPILOT_HOME=~/.copilot

# Avoid writing prompt and response bodies to logs.
LOG_LEVEL=info

# Client side: bin/claude-litellm reads these to reach a LiteLLM gateway.
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=replace-with-a-scoped-virtual-key
LITELLM_MODEL=claude-sonnet-5

# Optional Claude Code family mappings. They default to LITELLM_MODEL.
# LITELLM_OPUS_MODEL=claude-opus-5
# LITELLM_SONNET_MODEL=claude-sonnet-5
# LITELLM_HAIKU_MODEL=claude-haiku-4.5

# Gateway side: examples/litellm-github-copilot.yaml resolves both through
# os.environ/, so scripts/start-litellm.sh refuses to start when either is unset.
# The URL is the bridge root, with no /v1: LiteLLM appends /v1/messages on its
# own. The token is the one `node src/bridge-daemon.mjs ensure <model> <port>`
# prints, and it is also stored in the daemon registry bridge.json. It rotates
# on every daemon restart, so re-export it and restart LiteLLM after one. Never
# commit a real token.
# GHCP_BRIDGE_URL=http://127.0.0.1:4142
# GHCP_BRIDGE_TOKEN=replace-with-the-token-from-bridge-daemon-ensure
