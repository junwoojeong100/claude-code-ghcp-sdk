#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/bin/resolve-claude.sh"
export PATH="$ROOT_DIR/node_modules/.bin:$PATH"

# Command-line settings bypass Claude Code's rollout-based renderer selection.
# Restore the fullscreen renderer used by the unwrapped Claude Code command.
if [[ -z "${CLAUDE_CODE_NO_FLICKER+x}" ]]; then
  export CLAUDE_CODE_NO_FLICKER=1
fi

GHCP_MODEL_VALUE="${GHCP_MODEL:-claude-sonnet-5}"
BRIDGE_PORT="${GHCP_BRIDGE_PORT:-}"
CLAUDE_ARGS=()
PERSISTENT_BRIDGE=0

usage() {
  cat <<'EOF'
Usage: claude-ghcp [bridge options] [--] [claude options and prompt]

Bridge options:
  --ghcp-model MODEL   GitHub Copilot model ID (default: claude-sonnet-5)
  --bridge-port PORT   Fixed loopback port (default: choose a free port)
  --background, --bg   Use a persistent bridge for background agent sessions
  -h, --help           Show this help

Use --ghcp-model instead of Claude Code's --model flag. The launcher maps the
GitHub Copilot model to a Claude Code-compatible frontend model name.
EOF
}

while (($#)); do
  case "$1" in
    --ghcp-model)
      [[ $# -ge 2 ]] || { echo "--ghcp-model requires a value" >&2; exit 2; }
      GHCP_MODEL_VALUE="$2"
      shift 2
      ;;
    --ghcp-model=*)
      GHCP_MODEL_VALUE="${1#*=}"
      shift
      ;;
    --bridge-port)
      [[ $# -ge 2 ]] || { echo "--bridge-port requires a value" >&2; exit 2; }
      BRIDGE_PORT="$2"
      shift 2
      ;;
    --bridge-port=*)
      BRIDGE_PORT="${1#*=}"
      shift
      ;;
    --model|--model=*)
      echo "Use --ghcp-model; passing Claude Code --model would make the selected backend ambiguous." >&2
      exit 2
      ;;
    --settings|--settings=*)
      echo "Custom --settings is not supported because it can disable GHCP routing." >&2
      exit 2
      ;;
    --background|--bg)
      PERSISTENT_BRIDGE=1
      CLAUDE_ARGS+=("$1")
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      for argument in "$@"; do
        case "$argument" in
          --model|--model=*|--settings|--settings=*)
            echo "Do not pass --model or --settings through --; use GHCP launcher options." >&2
            exit 2
            ;;
          --background|--bg)
            PERSISTENT_BRIDGE=1
            ;;
        esac
      done
      CLAUDE_ARGS+=("$@")
      break
      ;;
    *)
      CLAUDE_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "${CLAUDE_ARGS[0]:-}" == "agents" ]]; then
  PERSISTENT_BRIDGE=1
fi

for command in node copilot curl; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Required command not found: $command" >&2
    exit 1
  }
done

CLAUDE_BIN="$(resolve_claude_code_bin "$ROOT_DIR")"

if [[ ! -d "$ROOT_DIR/node_modules/@github/copilot-sdk" ]]; then
  echo "Dependencies are missing. Run: npm install --prefix \"$ROOT_DIR\"" >&2
  exit 1
fi

if [[ -z "$BRIDGE_PORT" ]] && ((PERSISTENT_BRIDGE == 0)); then
  BRIDGE_PORT="$(
    node -e 'const net=require("node:net");const s=net.createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close();});'
  )"
fi

FRONTEND_MODEL="$(node "$ROOT_DIR/src/model-cli.mjs" frontend "$GHCP_MODEL_VALUE")"
RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/claude-ghcp.XXXXXX")"
BRIDGE_LOG="$RUNTIME_DIR/bridge.log"
# Assigned per mode below: the ephemeral bridge owns a file under RUNTIME_DIR,
# the persistent bridge hands one out of the daemon directory instead.
SETTINGS_FILE=""
BRIDGE_PID=""
BRIDGE_TOKEN=""

cleanup() {
  if [[ -n "$BRIDGE_PID" ]] && kill -0 "$BRIDGE_PID" 2>/dev/null; then
    kill "$BRIDGE_PID" 2>/dev/null || true
    wait "$BRIDGE_PID" 2>/dev/null || true
  fi
  # In persistent-bridge mode the settings file must outlive this process.
  # Claude Code hands a backgrounded session to its own daemon, which respawns
  # the worker with --settings <path> long after this launcher has returned;
  # deleting it here killed every such session with "Settings file not found".
  # Its lifetime belongs to the bridge daemon, and claude-ghcp-stop ends it.
  if ((PERSISTENT_BRIDGE == 0)) && [[ -n "$SETTINGS_FILE" ]]; then
    rm -f "$SETTINGS_FILE"
  fi
  rm -rf "$RUNTIME_DIR"
}
trap cleanup EXIT INT TERM

if ((PERSISTENT_BRIDGE)); then
  DAEMON_JSON="$(
    node "$ROOT_DIR/src/bridge-daemon.mjs" \
      ensure "$GHCP_MODEL_VALUE" "$BRIDGE_PORT"
  )"
  BRIDGE_PORT="$(
    printf '%s' "$DAEMON_JSON" |
      node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>console.log(JSON.parse(d).port))'
  )"
  BRIDGE_TOKEN="$(
    printf '%s' "$DAEMON_JSON" |
      node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>console.log(JSON.parse(d).token))'
  )"
  SETTINGS_FILE="$(
    printf '%s' "$DAEMON_JSON" |
      node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>console.log(JSON.parse(d).settingsPath))'
  )"
  # The daemon writes its own log; RUNTIME_DIR's copy is never created, and the
  # error paths below would `sed` a file that does not exist.
  BRIDGE_LOG="$(
    printf '%s' "$DAEMON_JSON" |
      node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>console.log(JSON.parse(d).logPath))'
  )"
else
  SETTINGS_FILE="$RUNTIME_DIR/settings.json"
  BRIDGE_TOKEN="$(
    node -e 'console.log(require("node:crypto").randomBytes(24).toString("hex"))'
  )"
  BRIDGE_API_KEY="$BRIDGE_TOKEN" \
  GHCP_MODEL="$GHCP_MODEL_VALUE" \
  HOST=127.0.0.1 \
  PORT="$BRIDGE_PORT" \
  node "$ROOT_DIR/src/server.mjs" >"$BRIDGE_LOG" 2>&1 &
  BRIDGE_PID=$!

  # A cold boot makes three upstream Copilot round-trips before the server
  # listens, so the old 30s ceiling gave up on a bridge that was still booting.
  # The ceiling is a wall-clock deadline rather than an iteration count because
  # an iteration costs the curl probe as well as the sleep: `N * 0.25s` is only
  # the floor, and against a bridge that binds the port but never answers a bare
  # curl hangs for minutes (verified: still running at 20s with no --max-time).
  # --max-time caps that, so the wait really is bounded by 60s plus at most one
  # overshooting iteration (2s + 0.25s), and the two confirmation probes below
  # add a 5s cap each: 72.25s worst case. Nothing used to pin any of these --
  # every bound could be deleted with the suite still green -- so
  # test/launcher.test.mjs now parses these five numbers back out of this file
  # and re-adds them against the figure on this line. Change one without
  # changing the other and that test goes red.
  #
  # 60s and not more because this ceiling is spent out of a caller's budget. The
  # v11 driver's second launch is spawnSync(bin/claude-ghcp, ["-p", ...],
  # {timeout: 180_000}) in scripts/verify/drivers.mjs, and with no --background
  # it takes this ephemeral branch, so 180 - 72.25 leaves ~107s for the Claude
  # turn itself -- against a measured 63.1s and 63.5s for the equivalent
  # single-turn read-and-answer (.verify-runs/2026-09-21T02-02-27-681Z/
  # slots.jsonl, v01-repo-recon evidence.durationMs). A 120s ceiling here would
  # have left ~60s and had spawnSync SIGKILL a bridge that was merely slow to
  # boot -- the exact case this wait exists to tolerate.
  #
  # A dead PID is still caught on the next iteration.
  HEALTH_DEADLINE=$((SECONDS + 60))
  while ((SECONDS < HEALTH_DEADLINE)); do
    if curl --silent --fail --max-time 2 "http://127.0.0.1:$BRIDGE_PORT/health" >/dev/null 2>&1; then
      break
    fi
    if ! kill -0 "$BRIDGE_PID" 2>/dev/null; then
      echo "The GHCP bridge exited during startup:" >&2
      sed -n '1,120p' "$BRIDGE_LOG" >&2
      exit 1
    fi
    sleep 0.25
  done
fi

# Capped for the same reason as the loop probe: an uncapped curl against a port
# that is bound but silent would spend minutes here, past every caller's budget.
curl --silent --fail --max-time 5 "http://127.0.0.1:$BRIDGE_PORT/health" >/dev/null || {
  echo "Timed out waiting for the GHCP bridge." >&2
  sed -n '1,120p' "$BRIDGE_LOG" >&2
  exit 1
}

# Capped like both probes above, and for a sharper reason: this one is a fetch,
# so an AbortSignal is the only thing that bounds it. Undici's default header
# timeout runs to minutes, and against a port that is bound but silent an
# unsignalled fetch outlives the whole ceiling above -- measured still pending
# at 30s against a listener that accepts the connection and never writes, while
# the capped curl beside it gave up at 2.04s. 5s matches the health probe above;
# src/bridge-daemon.mjs caps this same endpoint at 2s, and once /health answers
# this route is an in-memory read of manager.listModels() with no upstream
# round-trip, so 5s is slack rather than a budget.
if ! node -e '
  const [url, token, expected] = process.argv.slice(1);
  fetch(url, {
    headers: {"x-api-key": token},
    signal: AbortSignal.timeout(5_000),
  })
    .then((response) => {
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.json();
    })
    .then((body) => {
      if (!body.data.some((model) =>
        model.id === expected || model.backend_id === expected
      )) process.exit(1);
    })
    .catch((error) => {
      console.error(error.message);
      process.exit(2);
    });
' "http://127.0.0.1:$BRIDGE_PORT/v1/models?all=true" "$BRIDGE_TOKEN" "$GHCP_MODEL_VALUE"; then
  echo "GitHub Copilot model is unavailable: $GHCP_MODEL_VALUE" >&2
  echo "Run \"$ROOT_DIR/bin/ghcp-models\" to list available adapter models." >&2
  exit 1
fi

node "$ROOT_DIR/src/write-launch-settings.mjs" \
  "$SETTINGS_FILE" \
  "http://127.0.0.1:$BRIDGE_PORT" \
  "$BRIDGE_TOKEN" \
  "$FRONTEND_MODEL"

CLAUDE_COMMAND=(
  "$CLAUDE_BIN"
  --settings "$SETTINGS_FILE"
  --model "$FRONTEND_MODEL"
)
if ((${#CLAUDE_ARGS[@]})); then
  CLAUDE_COMMAND+=("${CLAUDE_ARGS[@]}")
fi

STATUS=0
"${CLAUDE_COMMAND[@]}" || STATUS=$?
exit "$STATUS"
