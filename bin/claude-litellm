#!/usr/bin/env bash
set -euo pipefail

# Resolve a symlinked launcher (npm link, ~/.local/bin) to its checkout.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" == /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$ROOT_DIR/bin/resolve-claude.sh"

# Keep the native fullscreen TUI when provider settings are supplied by file.
if [[ -z "${CLAUDE_CODE_NO_FLICKER+x}" ]]; then
  export CLAUDE_CODE_NO_FLICKER=1
fi

LITELLM_BASE_URL_VALUE="${LITELLM_BASE_URL:-}"
LITELLM_MODEL_VALUE="${LITELLM_MODEL:-claude-sonnet-5}"
CLAUDE_ARGS=()

usage() {
  cat <<'EOF'
Usage: claude-litellm [gateway options] [--] [claude options and prompt]

Gateway options:
  --litellm-base-url URL  LiteLLM proxy base URL (or LITELLM_BASE_URL)
  --litellm-model MODEL   LiteLLM model alias (default: claude-sonnet-5)
  -h, --help              Show this help

Set LITELLM_API_KEY in the environment. The launcher writes provider settings,
key included, to a mode-0600 file. A print-mode run (-p without --background
or --bg) removes it when Claude Code exits. Other launches keep it, because
/background restarts a job from it later, in
${XDG_STATE_HOME:-~/.local/state}/claude-code-ghcp-sdk/litellm-settings; each
launch other than print mode first removes files there older than 7 days.
EOF
}

while (($#)); do
  case "$1" in
    --litellm-base-url)
      [[ $# -ge 2 ]] || { echo "--litellm-base-url requires a value" >&2; exit 2; }
      LITELLM_BASE_URL_VALUE="$2"
      shift 2
      ;;
    --litellm-base-url=*)
      LITELLM_BASE_URL_VALUE="${1#*=}"
      shift
      ;;
    --litellm-model)
      [[ $# -ge 2 ]] || { echo "--litellm-model requires a value" >&2; exit 2; }
      LITELLM_MODEL_VALUE="$2"
      shift 2
      ;;
    --litellm-model=*)
      LITELLM_MODEL_VALUE="${1#*=}"
      shift
      ;;
    --model|--model=*)
      echo "Use --litellm-model so the gateway and Claude Code model stay aligned." >&2
      exit 2
      ;;
    --settings|--settings=*)
      echo "Custom --settings is not supported because it can disable LiteLLM routing." >&2
      exit 2
      ;;
    --ghcp-model|--ghcp-model=*)
      echo "--ghcp-model is only valid for the direct GHCP SDK launcher." >&2
      exit 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      for argument in "$@"; do
        case "$argument" in
          --model|--model=*|--settings|--settings=*)
            echo "Do not pass --model or --settings through --; use LiteLLM launcher options." >&2
            exit 2
            ;;
        esac
      done
      CLAUDE_ARGS+=("$@")
      break
      ;;
    *)
      CLAUDE_ARGS+=("$1")
      shift
      ;;
  esac
done

[[ -n "$LITELLM_BASE_URL_VALUE" ]] || {
  echo "LITELLM_BASE_URL or --litellm-base-url is required." >&2
  exit 1
}
[[ -n "${LITELLM_API_KEY:-}" ]] || {
  echo "LITELLM_API_KEY is required. Use a scoped LiteLLM virtual key." >&2
  exit 1
}

command -v node >/dev/null 2>&1 || {
  echo "Required command not found: node" >&2
  exit 1
}
CLAUDE_BIN="$(resolve_claude_code_bin "$ROOT_DIR")"

# Only print mode runs start to finish inside this process. Claude Code's
# daemon respawns a /background or --background job with --settings <path>
# after this launcher has exited, so deleting that file here killed the job
# with "Settings file not found" (bin/claude-ghcp keeps its files for the same
# reason). The file holds the LiteLLM key: it stays private to this user and is
# reaped by age, since nothing knows when a background job is finally done.
KEEP_SETTINGS=1
BACKGROUND=0
for argument in ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}; do
  case "$argument" in
    -p|--print) KEEP_SETTINGS=0 ;;
    --background|--bg) BACKGROUND=1 ;;
  esac
done
if ((BACKGROUND)); then
  KEEP_SETTINGS=1
fi

if ((KEEP_SETTINGS == 0)); then
  RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/claude-litellm.XXXXXX")"
  SETTINGS_FILE="$RUNTIME_DIR/settings.json"
  cleanup() {
    rm -f "$SETTINGS_FILE"
    rmdir "$RUNTIME_DIR" 2>/dev/null || true
  }
  trap cleanup EXIT INT TERM
else
  STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
  # A relative path would resolve against whichever directory respawns the job.
  [[ "$STATE_HOME" == /* ]] || STATE_HOME="$HOME/.local/state"
  SETTINGS_DIR="$STATE_HOME/claude-code-ghcp-sdk/litellm-settings"
  (umask 077 && mkdir -p "$SETTINGS_DIR")
  chmod 700 "$STATE_HOME/claude-code-ghcp-sdk" "$SETTINGS_DIR"
  find "$SETTINGS_DIR" -maxdepth 1 -type f -name '*.json' -mmin +$((7 * 24 * 60)) -delete 2>/dev/null || true
  SETTINGS_FILE="$SETTINGS_DIR/$(
    node -e 'console.log(require("node:crypto").randomBytes(12).toString("hex"))'
  ).json"
fi

node "$ROOT_DIR/src/write-litellm-settings.mjs" \
  "$SETTINGS_FILE" \
  "$LITELLM_BASE_URL_VALUE" \
  "$LITELLM_MODEL_VALUE"

CLAUDE_COMMAND=(
  "$CLAUDE_BIN"
  --settings "$SETTINGS_FILE"
  --model "$LITELLM_MODEL_VALUE"
)
if ((${#CLAUDE_ARGS[@]})); then
  CLAUDE_COMMAND+=("${CLAUDE_ARGS[@]}")
fi

STATUS=0
"${CLAUDE_COMMAND[@]}" || STATUS=$?
exit "$STATUS"
